{
  "name": "mq-watcher",
  "version": "0.2.0",
  "description": "Local read-only ActiveMQ Classic store evidence explorer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kutaelee/mq-watcher.git"
  },
  "homepage": "https://github.com/kutaelee/mq-watcher#readme",
  "bugs": "https://github.com/kutaelee/mq-watcher/issues",
  "keywords": [
    "activemq",
    "kahadb",
    "forensics",
    "jms",
    "message-broker"
  ],
  "bin": {
    "mq-watcher": "bin/mq-watcher.mjs"
  },
  "files": [
    "bin",
    "dist",
    "LICENSE",
    "README.md",
    "README.ko.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:portable": "npm run build && node scripts/build-portable.mjs",
    "test:portable": "node scripts/smoke-portable.mjs",
    "start": "vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:fixtures": "node --test tests/fixtures.test.mjs",
    "test:broker-fixtures": "node --test tests/broker-fixtures.test.mjs",
    "fixtures:generate": "node scripts/generate-synthetic-fixtures.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "validate:store": "node scripts/validate-store.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "postject": "1.0.0-alpha.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.2.1"
  },
  "type": "module"
}
